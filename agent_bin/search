#!/usr/bin/env python3
"""search "query" [-n N] [--page P] [--json]

Web search through the local SearXNG. Prints title, URL and snippet per result.
"""

import argparse
import json
import sys
import textwrap
import urllib.parse
import urllib.request

ENDPOINT = "http://127.0.0.1:8888/search"


def main() -> int:
    ap = argparse.ArgumentParser(prog="search", description="Web search (SearXNG).")
    ap.add_argument("query", nargs="+")
    ap.add_argument("-n", type=int, default=10, help="max results (default 10)")
    ap.add_argument("--page", type=int, default=1)
    ap.add_argument("--json", action="store_true", help="raw JSON results")
    args = ap.parse_args()

    params = urllib.parse.urlencode({
        "q": " ".join(args.query),
        "format": "json",
        "pageno": args.page,
    })
    try:
        with urllib.request.urlopen(f"{ENDPOINT}?{params}", timeout=30) as r:
            data = json.load(r)
    except Exception as e:  # noqa: BLE001
        print(f"search failed: {e}", file=sys.stderr)
        return 1

    results = data.get("results", [])[: args.n]
    if args.json:
        json.dump(results, sys.stdout, indent=1)
        print()
        return 0
    if not results:
        print("no results")
        return 0
    for i, r in enumerate(results, 1):
        print(f"{i}. {r.get('title', '').strip()}")
        print(f"   {r.get('url', '')}")
        snippet = (r.get("content") or "").strip()
        if snippet:
            print(textwrap.indent(textwrap.fill(snippet[:300], 88), "   "))
    return 0


if __name__ == "__main__":
    sys.exit(main())
